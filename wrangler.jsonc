{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rsa-playground",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // SPA fallback: vue-router runs in history mode
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "rsa-playground.pavelseps.com", "custom_domain": true }
  ]
}
